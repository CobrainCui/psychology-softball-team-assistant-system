// Softball AI System — 权威数据契约（PostgreSQL）
// 对齐 lib 层：Player / GameArchive / Readiness（四象限）/ InjuryCase
// 单队试点：Team 预留一队；正式成绩在此，localStorage 仅作 session 草稿

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— 枚举：与前端 TypeScript 契约对齐 ———

enum Gender {
  male
  female
}

enum PlayerRole {
  player
  coach
}

/// 账密身份（与 Player.role 分阶段迁移；权限以 AccountRole 为准）
enum AccountStatus {
  active
  disabled
}

enum ActiveView {
  player
  captain
  coach
}

enum AccountRoleKind {
  player
  captain
  coach
  admin
}

enum MembershipClaimStatus {
  pending
  approved
  rejected
}

enum EnrollmentCodeStatus {
  active
  used
  revoked
}

enum RoleChangeRequestStatus {
  pending
  approved
  rejected
}

enum HitResult {
  LD
  FB
  GB
  PU
  MISS
}

enum PitchType {
  FB
  CB
  SL
  CH
  OT
}

enum HitQuality {
  Hard
  Medium
  Soft
}

enum PitchCall {
  strike
  ball
}

enum ThrowBlame {
  thrower
  firstBase
  both
}

enum TestDayDraftStatus {
  open
  frozen
  archived
}

enum TestDayEntryKind {
  hit
  fly_catch
  speed_mark
  strike_cell
  throw_play
  custom_player_note
  custom_group_note
  custom_single_note
}

enum TestDayEntryStatus {
  active
  tombstoned
}

enum TestDayConflictType {
  value_mismatch
  structure
  delete_request
}

enum TestDayConflictReviewStatus {
  open
  resolved
  dismissed
}

enum PainArea {
  shoulder
  elbow
  lumbar
  knee
  ankle
  wrist
  hip
  other
}

enum PreQuadrant {
  slack
  real_fatigue
  injury_risk
  peak
}

enum InjuryKind {
  overuse
  acute_strain
  contusion
  inflammation
  post_care
  unclear
}

enum InjuryCaseStatus {
  active
  recovered
}

enum InjuryNoteKind {
  treatment
  rehab
}

/// 生理周期事件类型（球员主权数据）
enum CycleEventType {
  period_start
  period_end
  spotting
  skip_month
}

enum CycleFlowLevel {
  light
  medium
  heavy
}

/// 教练可见范围：none=仅本人；load_only=脱敏负荷；phase_label=额外阶段名（默认关）
enum CycleSharingLevel {
  none
  load_only
  phase_label
}

/// 教练端脱敏生理负荷标签（禁止暴露经期原文）
enum PhysiologicalLoadTag {
  recover_high
  acl_caution
  maintain
  peak_ok
  monitor_health
}

enum CycleEnergyLevel {
  low
  mid
  high
}

enum CycleMoodLevel {
  steady
  irritable
  low
}

enum CycleConfidence {
  low
  medium
  high
}

enum CyclePhaseCode {
  menstrual
  follicular
  ovulation
  luteal
  late_luteal
}

enum SeasonStatus {
  planned
  active
  archived
}

enum ScheduleEventKind {
  game
  scrimmage
}

enum ScheduleEventStatus {
  planned
  cancelled
  completed
}

enum GameRecordFileStatus {
  pending
  ready
}

enum GameSummaryStatus {
  draft
  confirmed
}

enum GameResultKind {
  win
  loss
  tie
  unknown
}

enum GameSummarySource {
  manual
  iscore_pdf
}

// ——— 组织：一支球队（未来可扩展多队，当前只种子一队） ———

model Team {
  id        String   @id @default(cuid())
  name      String
  /// IANA 时区；赛季自然日与窗口展示用此时区
  timeZone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players         Player[]
  sessions        TestSession[]
  testDayDrafts   TestDayDraft[]
  accounts        Account[]
  enrollmentCodes EnrollmentCode[]
  seasons         Season[]
  scheduleEvents  ScheduleEvent[]
}

// ——— 名册；Player.role 分阶段废弃，权限见 AccountRole ———

model Player {
  id        String     @id @default(cuid())
  teamId    String
  name      String
  gender    Gender?
  /// @deprecated 分阶段迁移至 AccountRole；应用层勿再写入
  role      PlayerRole @default(player)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  team                 Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account              Account?
  membershipClaims     MembershipClaim[]
  hits                 Hit[]
  speedRecords         SpeedRecord[]
  speedMarks           SpeedMark[]
  flyCatchAttempts      FlyCatchAttempt[]
  strikeJudgeColumns    StrikeJudgeColumn[]
  strikeJudgeCells      StrikeJudgeCell[]
  throwPlaysAsThrower   ThrowPlay[] @relation("ThrowPlayThrower")
  throwPlaysAsFirstBase ThrowPlay[] @relation("ThrowPlayFirstBase")
  readinessChecks       ReadinessCheck[]
  injuryCases      InjuryCase[]
  sessionFeedbacks SessionFeedback[]
  cycleProfile     CycleProfile?
  cycleEvents      CycleEvent[]
  gamePlayerLines  ConfirmedGamePlayerLine[]

  @@index([teamId])
  @@index([name])
}

// ——— 综合测试日归档（原 GameArchive；hits/speed 拆表达 3NF） ———

model TestSession {
  id            String   @id @default(cuid())
  teamId        String
  /// 对应前端 schemaVersion，便于迁移与兼容
  schemaVersion Int      @default(2)
  /// 归档时刻（原 gameId/date 语义合并）
  archivedAt    DateTime
  /// 当场排阵快照（playerId → 测试项列表）
  assignments   Json?
  /// 当场测试项清单快照
  testItems     Json?
  /// 排阵 push 记录（修改人 + 添加/删除摘要）
  assignmentLog Json?
  /// 自定义测试定义与文字备注快照
  customTests   Json?
  /// 协作草稿归档来源；一草稿至多一份正式 TestSession
  sourceDraftId String?  @unique
  createdAt     DateTime @default(now())

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceDraft        TestDayDraft?       @relation(fields: [sourceDraftId], references: [id], onDelete: SetNull)
  hits               Hit[]
  speedRecords       SpeedRecord[]
  speedColumns       SpeedColumn[]
  speedMarks         SpeedMark[]
  flyCatchAttempts   FlyCatchAttempt[]
  strikeJudgeColumns StrikeJudgeColumn[]
  strikeJudgeCells   StrikeJudgeCell[]
  throwPlays         ThrowPlay[]

  @@index([teamId, archivedAt])
}

// ——— 协作测试日进行中草稿（正式成绩仍是归档后的 TestSession） ———

model TestDayDraft {
  id                 String             @id @default(cuid())
  teamId             String
  date               DateTime           @db.Date
  status             TestDayDraftStatus @default(open)
  schemaVersion      Int                @default(1)
  createdByAccountId String
  testItems          Json
  assignments        Json
  customTests        Json?
  /// 测速列 + 好球判断列
  skillStructure     Json?
  assignmentLog      Json?
  version            Int                @default(1)
  frozenAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  team      Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy Account              @relation("TestDayDraftCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  members   TestDayDraftMember[]
  entries   TestDayEntry[]
  conflicts TestDayConflict[]
  session   TestSession?

  @@index([teamId, status])
  @@index([teamId, date])
}

model TestDayDraftMember {
  id        String   @id @default(cuid())
  draftId   String
  accountId String
  joinedAt  DateTime @default(now())

  draft   TestDayDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  account Account      @relation("TestDayDraftMembership", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([draftId, accountId])
  @@index([accountId])
}

model TestDayEntry {
  id              String             @id @default(cuid())
  draftId         String
  kind            TestDayEntryKind
  entityKey       String
  payload         Json
  clientEntryId   String
  authorAccountId String
  status          TestDayEntryStatus @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  draft  TestDayDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  author Account      @relation("TestDayEntryAuthor", fields: [authorAccountId], references: [id], onDelete: Restrict)

  @@unique([draftId, clientEntryId])
  @@index([draftId, entityKey])
  @@index([draftId, status])
}

model TestDayConflict {
  id                  String                      @id @default(cuid())
  draftId             String
  entityKey           String
  type                TestDayConflictType
  candidateEntryIds   Json
  reviewStatus        TestDayConflictReviewStatus @default(open)
  resolvedByAccountId String?
  finalPayload        Json?
  resolvedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  draft      TestDayDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  resolvedBy Account?     @relation("TestDayConflictResolver", fields: [resolvedByAccountId], references: [id], onDelete: SetNull)

  @@index([draftId, reviewStatus])
  @@index([draftId, entityKey])
}

model Hit {
  id          String      @id @default(cuid())
  sessionId   String
  playerId    String
  result      HitResult
  /// 落点百分比 0–100；MISS 为空
  x           Float?
  y           Float?
  pitchType   PitchType?
  hitQuality  HitQuality?
  recordedAt  DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([playerId])
}

model SpeedRecord {
  id                String   @id @default(cuid())
  sessionId         String
  playerId          String
  firstBaseSeconds  Float?
  secondBaseSeconds Float?
  customSeconds     Float?
  recordedAt        DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([playerId])
}

model SpeedColumn {
  id         String   @id
  sessionId  String
  name       String
  sortOrder  Int
  recordedAt DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  marks   SpeedMark[]

  @@index([sessionId])
}

model SpeedMark {
  id         String   @id @default(cuid())
  sessionId  String
  columnId   String
  playerId   String
  seconds    Float
  recordedAt DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  column  SpeedColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([columnId, playerId])
  @@index([sessionId])
  @@index([playerId])
}

model FlyCatchAttempt {
  id         String   @id @default(cuid())
  sessionId  String
  playerId   String
  caught     Boolean
  note       String?
  recordedAt DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([playerId])
}

model StrikeJudgeColumn {
  id         String   @id @default(cuid())
  sessionId  String
  pitcherId  String
  sortOrder  Int
  recordedAt DateTime

  session TestSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pitcher Player          @relation(fields: [pitcherId], references: [id], onDelete: Restrict)
  cells   StrikeJudgeCell[]

  @@index([sessionId])
  @@index([pitcherId])
}

model StrikeJudgeCell {
  id         String    @id @default(cuid())
  sessionId  String
  columnId   String
  judgeId    String
  pitchCall  PitchCall
  swung      Boolean
  recordedAt DateTime

  session TestSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  column  StrikeJudgeColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  judge   Player            @relation(fields: [judgeId], references: [id], onDelete: Restrict)

  @@unique([columnId, judgeId])
  @@index([sessionId])
  @@index([judgeId])
}

model ThrowPlay {
  id          String      @id @default(cuid())
  sessionId   String
  testItem    String
  throwerId   String
  firstBaseId String
  success     Boolean
  blame       ThrowBlame?
  note        String?
  recordedAt  DateTime

  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thrower   Player      @relation("ThrowPlayThrower", fields: [throwerId], references: [id], onDelete: Restrict)
  firstBase Player      @relation("ThrowPlayFirstBase", fields: [firstBaseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, testItem, throwerId, firstBaseId])
  @@index([sessionId])
  @@index([throwerId])
  @@index([firstBaseId])
}

// ——— 每日综合状态评估（五维 1–5 + 四象限；playerId+date 唯一） ———

model ReadinessCheck {
  id               String      @id @default(cuid())
  playerId         String
  /// 自然日 YYYY-MM-DD（UTC 日期边界由应用层约定）
  date             DateTime    @db.Date
  /// 五维均为 1 极差 → 5 极佳（fatigue/soreness/stress 字段名历史遗留）
  sleep            Int
  stress           Int
  fatigue          Int
  soreness         Int
  willingness      Int
  physicalBattery  Float
  mentalDrive      Int
  quadrant         PreQuadrant
  ruleVersion      String      @default("pre_quadrant_v1")
  /// 生理周期快照（可选；教练 API 默认不返回原始日期）
  cycleDay               Int?
  cyclePhaseCode         CyclePhaseCode?
  cycleConfidence        CycleConfidence?
  physiologicalLoadTag   PhysiologicalLoadTag?
  crampsScore            Int?
  cycleEnergy            CycleEnergyLevel?
  cycleMood              CycleMoodLevel?
  cycleIrregularFlag     Boolean           @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([playerId, date])
}

// ——— 女性生理周期：知情同意 + 事件史（权威在云端） ———

model CycleProfile {
  id                    String            @id @default(cuid())
  playerId              String            @unique
  trackingEnabled       Boolean           @default(false)
  sharingLevel          CycleSharingLevel @default(none)
  /// 有 ≥3 次经期间隔后写入中位数；冷启动可空
  typicalLengthDays     Int?
  hormonalContraception Boolean           @default(false)
  /// 敏感项：需球员二次确认后才参与 RED-S 哨兵
  bodyImageAnxietyOptIn Boolean           @default(false)
  consentAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CycleEvent {
  id          String           @id @default(cuid())
  playerId    String
  eventType   CycleEventType
  date        DateTime         @db.Date
  flowLevel   CycleFlowLevel?
  crampsScore Int?
  energyLevel CycleEnergyLevel?
  moodLevel   CycleMoodLevel?
  notes       String?
  createdAt   DateTime         @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, date])
  @@index([playerId, eventType, date])
}

// ——— 损伤 episode（疼痛日志 / 诊疗 / 康复；与 Readiness 互不熔断） ———

model InjuryCase {
  id            String           @id @default(cuid())
  playerId      String
  schemaVersion Int              @default(2)
  painArea      PainArea
  locationHint  String           @default("")
  injuryKind    InjuryKind
  status        InjuryCaseStatus @default(active)
  startDate     DateTime         @db.Date
  recoveredAt   DateTime?        @db.Date
  parentCaseId  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  parent     InjuryCase?       @relation("InjuryRecurrence", fields: [parentCaseId], references: [id], onDelete: SetNull)
  recurrences InjuryCase[]     @relation("InjuryRecurrence")
  painLogs   InjuryPainLog[]
  notes      InjuryNoteRecord[]

  @@index([playerId, status])
  @@index([playerId, startDate])
}

model InjuryPainLog {
  id                     String   @id @default(cuid())
  caseId                 String
  date                   DateTime @db.Date
  painScore              Int
  painExerciseRelations  String[]
  note                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  injuryCase InjuryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, date])
}

model InjuryNoteRecord {
  id        String         @id @default(cuid())
  caseId    String
  kind      InjuryNoteKind
  date      DateTime       @db.Date
  content   String
  createdAt DateTime       @default(now())

  injuryCase InjuryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, kind])
}

// ——— 训后反馈（活动类型多选 + 疲劳 1–10；同日可多条） ———

model SessionFeedback {
  id            String   @id @default(cuid())
  playerId      String
  schemaVersion Int      @default(3)
  date          DateTime @db.Date
  /// 预设 code 或自定义原文；旧 other 回填为空数组
  activityTypes String[]
  sessionRpe    Int
  /// 历史时长；新写入为 null
  durationMin   Int?
  /// 新写入等于 sessionRpe；界面不再展示负荷
  sessionLoad   Int
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, date])
}

// ——— 账密身份（单队；Account 与 Player 分离） ———

model Account {
  id            String        @id @default(cuid())
  teamId        String
  username      String        @unique
  passwordHash  String
  email         String?
  phone         String?
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  status        AccountStatus @default(active)
  activeView    ActiveView    @default(player)
  playerId      String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  team                    Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player                  Player?                 @relation(fields: [playerId], references: [id], onDelete: SetNull)
  roles                   AccountRole[]
  sessions                AuthSession[]
  membershipClaim         MembershipClaim?
  passwordResetTokens     PasswordResetToken[]
  roleChangeRequests      RoleChangeRequest[]
  enrollmentCodesCreated  EnrollmentCode[]        @relation("EnrollmentCodeCreator")
  enrollmentCodesUsed     EnrollmentCode[]        @relation("EnrollmentCodeUser")
  claimsReviewed          MembershipClaim[]       @relation("ClaimReviewer")
  roleChangesReviewed     RoleChangeRequest[]     @relation("RoleChangeReviewer")
  auditLogsAsActor        AuthAuditLog[]          @relation("AuditActor")
  seasonsActivated        Season[]                @relation("SeasonActivatedBy")
  seasonsArchived         Season[]                @relation("SeasonArchivedBy")
  eventsCorrected         ScheduleEvent[]         @relation("ScheduleEventCorrectedBy")
  gameFilesUploaded       GameRecordFile[]        @relation("GameFileUploader")
  gameFilesDeleted        GameRecordFile[]        @relation("GameFileDeleter")
  gameSummariesConfirmed  ConfirmedGameSummary[]  @relation("GameSummaryConfirmer")
  testDayDraftsCreated    TestDayDraft[]          @relation("TestDayDraftCreator")
  testDayDraftMemberships TestDayDraftMember[]    @relation("TestDayDraftMembership")
  testDayEntriesAuthored  TestDayEntry[]          @relation("TestDayEntryAuthor")
  testDayConflictsResolved TestDayConflict[]      @relation("TestDayConflictResolver")

  @@index([teamId])
}

model AccountRole {
  id                 String          @id @default(cuid())
  accountId          String
  role               AccountRoleKind
  grantedByAccountId String?
  grantedAt          DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([accountId])
}

model MembershipClaim {
  id                  String                @id @default(cuid())
  accountId           String                @unique
  status              MembershipClaimStatus @default(pending)
  displayName         String
  playerId            String?
  reviewedByAccountId String?
  reviewedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  reviewer Account? @relation("ClaimReviewer", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)

  @@index([status])
}

model EnrollmentCode {
  id                 String               @id @default(cuid())
  teamId             String
  codeHash           String               @unique
  status             EnrollmentCodeStatus @default(active)
  expiresAt          DateTime?
  usedAt             DateTime?
  usedByAccountId    String?
  revokedAt          DateTime?
  revokedNote        String?
  createdByAccountId String?
  createdAt          DateTime             @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator   Account? @relation("EnrollmentCodeCreator", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  usedBy    Account? @relation("EnrollmentCodeUser", fields: [usedByAccountId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
}

model AuthSession {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model RoleChangeRequest {
  id                  String                  @id @default(cuid())
  accountId           String
  requestedRole       AccountRoleKind
  status              RoleChangeRequestStatus @default(pending)
  reviewedByAccountId String?
  reviewedAt          DateTime?
  createdAt           DateTime                @default(now())

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reviewer Account? @relation("RoleChangeReviewer", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)

  @@index([accountId, status])
}

model AuthAuditLog {
  id              String   @id @default(cuid())
  action          String
  actorAccountId  String?
  targetAccountId String?
  targetId        String?
  metadata        Json?
  ip              String?
  createdAt       DateTime @default(now())

  actor Account? @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model AuthRateLimit {
  bucket    String   @id
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt
}

// ——— 赛季 / 赛程 / 比赛文件与确认摘要 ———

model Season {
  id               String       @id @default(cuid())
  teamId           String
  name             String
  startsOn         DateTime     @db.Date
  endsOn           DateTime     @db.Date
  effectiveEndsOn  DateTime     @db.Date
  status           SeasonStatus @default(planned)
  activatedById    String?
  archivedById     String?
  activatedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activatedBy Account? @relation("SeasonActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  archivedBy  Account? @relation("SeasonArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  events      ScheduleEvent[]

  @@unique([id, teamId])
  @@index([teamId, status])
}

model ScheduleEvent {
  id            String               @id @default(cuid())
  teamId        String
  seasonId      String?
  kind          ScheduleEventKind
  status        ScheduleEventStatus  @default(planned)
  startAt       DateTime
  endAt         DateTime
  opponent      String?
  venue         String?
  title         String?
  note          String?
  statusNote    String?
  correctedAt   DateTime?
  correctedById String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season      Season?  @relation(fields: [seasonId, teamId], references: [id, teamId], onDelete: Restrict)
  correctedBy Account? @relation("ScheduleEventCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  files       GameRecordFile[]
  summaries   ConfirmedGameSummary[]

  @@index([teamId, startAt])
  @@index([seasonId])
}

model GameRecordFile {
  id            String               @id @default(cuid())
  teamId        String
  scheduleEventId String
  storageKey    String               @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  source        String               @default("upload")
  status        GameRecordFileStatus @default(pending)
  uploadedById  String
  uploadedAt    DateTime             @default(now())
  deletedAt     DateTime?
  deletedById   String?
  retainEvidence Boolean             @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  event      ScheduleEvent @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  uploadedBy Account       @relation("GameFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  Account?      @relation("GameFileDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  summaries  ConfirmedGameSummary[]

  @@index([scheduleEventId, status])
  @@index([teamId])
}

model ConfirmedGameSummary {
  id               String            @id @default(cuid())
  teamId           String
  scheduleEventId  String
  status           GameSummaryStatus @default(draft)
  ourScore         Int?
  opponentScore    Int?
  result           GameResultKind    @default(unknown)
  source           GameSummarySource @default(manual)
  sourceFileId     String?
  confirmedById    String?
  confirmedAt      DateTime?
  version          Int               @default(1)
  supersededAt     DateTime?
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  event       ScheduleEvent  @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  sourceFile  GameRecordFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  confirmedBy Account?       @relation("GameSummaryConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  lines       ConfirmedGamePlayerLine[]

  @@index([scheduleEventId, status])
  @@index([teamId])
}

model ConfirmedGamePlayerLine {
  id            String  @id @default(cuid())
  summaryId     String
  playerId      String
  participated  Boolean @default(true)

  summary ConfirmedGameSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  player  Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([summaryId, playerId])
  @@index([playerId])
}
