// Softball AI System — 权威数据契约（PostgreSQL）
// 对齐 lib 层：Player / GameArchive / Readiness / InjuryLog
// 单队试点：Team 预留一队；正式成绩在此，localStorage 仅作 session 草稿

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— 枚举：与前端 TypeScript 契约对齐 ———

enum Gender {
  male
  female
}

enum PlayerRole {
  player
  coach
}

enum HitResult {
  LD
  FB
  GB
  PU
  MISS
}

enum PitchType {
  FB
  CB
  SL
  CH
  OT
}

enum HitQuality {
  Hard
  Medium
  Soft
}

enum PainArea {
  shoulder
  elbow
  lumbar
  knee
  ankle
  wrist
}

enum ProbeFeedback {
  A
  B
  C
}

/// 与 assessment 页面 SleepQuality 对齐
enum SleepQuality {
  good
  normal
  bad
}

/// 生理周期事件类型（球员主权数据）
enum CycleEventType {
  period_start
  period_end
  spotting
  skip_month
}

enum CycleFlowLevel {
  light
  medium
  heavy
}

/// 教练可见范围：none=仅本人；load_only=脱敏负荷；phase_label=额外阶段名（默认关）
enum CycleSharingLevel {
  none
  load_only
  phase_label
}

/// 教练端脱敏生理负荷标签（禁止暴露经期原文）
enum PhysiologicalLoadTag {
  recover_high
  acl_caution
  maintain
  peak_ok
  monitor_health
}

enum CycleEnergyLevel {
  low
  mid
  high
}

enum CycleMoodLevel {
  steady
  irritable
  low
}

enum CycleConfidence {
  low
  medium
  high
}

enum CyclePhaseCode {
  menstrual
  follicular
  ovulation
  luteal
  late_luteal
}

// ——— 组织：一支球队（未来可扩展多队，当前只种子一队） ———

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players  Player[]
  sessions TestSession[]
}

// ——— 名册 + 极简身份（教练/队员）；登录后续可挂 Credential ———

model Player {
  id        String     @id @default(cuid())
  teamId    String
  name      String
  gender    Gender?
  role      PlayerRole @default(player)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hits            Hit[]
  speedRecords    SpeedRecord[]
  readinessChecks ReadinessCheck[]
  injuryLogs      InjuryLog[]
  sessionFeedbacks SessionFeedback[]
  cycleProfile    CycleProfile?
  cycleEvents     CycleEvent[]

  @@index([teamId])
  @@index([name])
}

// ——— 综合测试日归档（原 GameArchive；hits/speed 拆表达 3NF） ———

model TestSession {
  id            String   @id @default(cuid())
  teamId        String
  /// 对应前端 schemaVersion，便于迁移与兼容
  schemaVersion Int      @default(1)
  /// 归档时刻（原 gameId/date 语义合并）
  archivedAt    DateTime
  createdAt     DateTime @default(now())

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hits         Hit[]
  speedRecords SpeedRecord[]

  @@index([teamId, archivedAt])
}

model Hit {
  id          String      @id @default(cuid())
  sessionId   String
  playerId    String
  result      HitResult
  /// 落点百分比 0–100；MISS 为空
  x           Float?
  y           Float?
  pitchType   PitchType?
  hitQuality  HitQuality?
  recordedAt  DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([playerId])
}

model SpeedRecord {
  id                String   @id @default(cuid())
  sessionId         String
  playerId          String
  firstBaseSeconds  Float?
  secondBaseSeconds Float?
  customSeconds     Float?
  recordedAt        DateTime

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([playerId])
}

// ——— 每日综合状态评估（原 readiness history；playerId+date 唯一） ———

model ReadinessCheck {
  id              String         @id @default(cuid())
  playerId        String
  /// 自然日 YYYY-MM-DD（UTC 日期边界由应用层约定）
  date            DateTime       @db.Date
  readinessScore  Int
  hasNewInjury    Boolean        @default(false)
  injuryPart      PainArea?
  injuryScore     Int            @default(0)
  probeFeedback   ProbeFeedback?
  /// Wellness 原值（队内启发式输入；可复盘趋势）
  sleepQuality    SleepQuality?
  stressScore     Int?
  fatigueScore    Int?
  sorenessScore   Int?
  /// 生理周期快照（可选；教练 API 默认不返回原始日期）
  cycleDay               Int?
  cyclePhaseCode         CyclePhaseCode?
  cycleConfidence        CycleConfidence?
  physiologicalLoadTag   PhysiologicalLoadTag?
  crampsScore            Int?
  cycleEnergy            CycleEnergyLevel?
  cycleMood              CycleMoodLevel?
  cycleIrregularFlag     Boolean           @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([playerId, date])
}

// ——— 女性生理周期：知情同意 + 事件史（权威在云端） ———

model CycleProfile {
  id                    String            @id @default(cuid())
  playerId              String            @unique
  trackingEnabled       Boolean           @default(false)
  sharingLevel          CycleSharingLevel @default(none)
  /// 有 ≥3 次经期间隔后写入中位数；冷启动可空
  typicalLengthDays     Int?
  hormonalContraception Boolean           @default(false)
  /// 敏感项：需球员二次确认后才参与 RED-S 哨兵
  bodyImageAnxietyOptIn Boolean           @default(false)
  consentAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CycleEvent {
  id          String           @id @default(cuid())
  playerId    String
  eventType   CycleEventType
  date        DateTime         @db.Date
  flowLevel   CycleFlowLevel?
  crampsScore Int?
  energyLevel CycleEnergyLevel?
  moodLevel   CycleMoodLevel?
  notes       String?
  createdAt   DateTime         @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, date])
  @@index([playerId, eventType, date])
}

// ——— 伤病处方归档（原 injury log） ———

model InjuryLog {
  id            String   @id @default(cuid())
  playerId      String
  schemaVersion Int      @default(1)
  painArea      PainArea
  painScore     Int
  symptom       String
  createdAt     DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

// ——— 训后主观负荷（Session RPE × 时长；教练日摘要用） ———

model SessionFeedback {
  id            String    @id @default(cuid())
  playerId      String
  schemaVersion Int       @default(1)
  date          DateTime  @db.Date
  sessionRpe    Int
  durationMin   Int
  hasPain       Boolean   @default(false)
  painArea      PainArea?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([playerId, date])
}
