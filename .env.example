# 复制本文件为 `.env` 后填入真实连接串。切勿提交 `.env`。
#
# —— 首次部署 ——
# 1. 填 DATABASE_URL（Prisma Postgres / Vercel Postgres 均可）
# 2. 填 AUTH_BOOTSTRAP_SECRET（随机长串，只用于 /setup 创建首个管理员）
# 3. 填 NEXT_PUBLIC_APP_URL（正式站点 origin，重置链接依赖它）
# 4. npx prisma migrate deploy && npm run build
# 5. 打开 /login；若尚未创建管理员，页面会给出 /setup 入口
#
# Vercel Storage → Postgres → Connect → `.env.local` 片段中通常有：
#   POSTGRES_URL / POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING 等
# Prisma 迁移与客户端优先使用 DATABASE_URL；可与 Vercel 变量二选一：
#
# 方式 A（推荐）：把 Prisma 用的 URL 写成 DATABASE_URL
# DATABASE_URL="postgres://..."
#
# 方式 B：沿用 Vercel 变量名，并保证至少有一个可用
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL="postgres://..."

DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# 写库回归（verify:auth-actions / verify:test-day-collab-actions / verify:ui / verify:season）必须指向独立测试库。
# 未设置、或规范化后与 DATABASE_URL 相同，脚本会直接失败，避免误写生产/开发库。
# TEST_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/softball_test?sslmode=require"

# 首次创建管理员的引导密钥；生产必须设置且不可提交
AUTH_BOOTSTRAP_SECRET="replace-with-a-long-random-secret"

# 正式站点 origin（不含尾斜杠）。生产必须设置；本地可沿用下方值
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 生产：
# NEXT_PUBLIC_APP_URL="https://psysoftball.run"

# 赛程 PDF：Vercel 连接私有 Blob 后会注入 token / store id。
# 未设置时本地与 verify:season 走 `.tmp/season-blob`
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

